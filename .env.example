# --- v1: WhatsApp lead capture + booking (client-side, safe to expose) ---
# The number the "Begin a gift" flow hands off to (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=919712243992
# Optional: a public Google Calendar Appointment / Calendly / Cal.com link.
# No API key needed — it's embedded as an iframe. Leave blank to hide booking
# and use WhatsApp only.
NEXT_PUBLIC_BOOKING_URL=

# --- v2 (the SaaS studio, currently gated behind the coming-soon wall) ---
# AI (server-side only, never NEXT_PUBLIC): powers the conversation chatbot
# and card drafting. Without it the studio falls back to a scripted flow.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8
CHAT_MODEL=

# Firebase (client-side config, safe to expose): Auth + Firestore mirroring.
# Without these the app runs in guest mode with localStorage persistence.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
